NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
LOG_LEVEL=info
# Comma-separated origins. Use * only for local development.
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
# Replace all placeholder database values locally; do not commit real credentials.
DATABASE_URL="postgresql://app_user:change_me@localhost:5432/collaboration_platform?schema=public"

# Generate unique values of at least 32 characters. Never commit actual secrets.
JWT_ACCESS_SECRET=replace_with_a_unique_32_character_minimum_access_secret
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=7

# Redis cache (run `docker compose up -d redis` locally before enabling)
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
REDIS_DEFAULT_TTL_SECONDS=60

# Kafka events (run `docker compose up -d kafka` locally before enabling)
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=collaboration-platform-api
KAFKA_GROUP_ID=collaboration-platform-cache
KAFKA_TOPIC=collaboration.domain-events
